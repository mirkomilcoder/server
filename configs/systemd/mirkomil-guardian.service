# Managed by mirkomil-server — edits are overwritten by install.sh
[Unit]
Description=Mirkomil Guardian (monitoring, alerts, local API)
Documentation=https://github.com/mirkomilcoder/server
After=network-online.target mirkomil-helper.service
Wants=network-online.target mirkomil-helper.service

[Service]
Type=notify
User=mirkomil
Group=mirkomil
# adm + systemd-journal: read the system journal; nothing else.
SupplementaryGroups=adm systemd-journal
Environment=PYTHONPATH=/opt/mirkomil/src/agent PYTHONDONTWRITEBYTECODE=1 MK_STATE=/var/lib/mirkomil/guardian
ExecStart=/usr/bin/python3 -m mirkomil guardian
StateDirectory=mirkomil/guardian
StateDirectoryMode=0750
Restart=always
RestartSec=5
WatchdogSec=90
NotifyAccess=main

# --- hardening: Guardian only reads the system and writes its own state ---
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/run/mirkomil
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
