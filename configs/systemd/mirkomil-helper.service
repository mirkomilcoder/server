# Managed by mirkomil-server — edits are overwritten by install.sh
# The only Mirkomil component running as root. It accepts a fixed list of
# validated verbs from the "mirkomil" user on /run/mirkomil/helper.sock.
[Unit]
Description=Mirkomil root helper (whitelisted privileged actions)
After=local-fs.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/mirkomil/src/agent PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m mirkomil helper
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
