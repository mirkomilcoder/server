# Managed by mirkomil-server — edits are overwritten by install.sh
# Cockpit login through Cloudflare Access: cockpit-ws hands "Authorization: Bearer <token>"
# here ([bearer] UnixPath in cockpit.conf). Only cockpit-ws's group may connect.
[Unit]
Description=Mirkomil SSO: Cockpit login with Cloudflare Access
Requires=cockpit-session-socket-user.service
After=cockpit-session-socket-user.service

[Socket]
ListenStream=/run/mirkomil-sso.sock
SocketUser=root
SocketGroup=cockpit-session-socket
SocketMode=0660
RemoveOnStop=yes
Accept=yes

[Install]
WantedBy=sockets.target
