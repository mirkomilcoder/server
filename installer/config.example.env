# Mirkomil Server — non-interactive install:
#   sudo ./install.sh --yes --config config.env
# Secrets (TS_AUTHKEY, TELEGRAM_BOT_TOKEN) are moved to /etc/mirkomil/secrets.env (root, 0600).

MK_HOSTNAME="home-server"
MK_ADMIN_USER="mirkomil"
MK_TIMEZONE="Asia/Tashkent"
# Local network allowed to open the panel (https://<ip>:9090), or "none"
MK_LAN_CIDR="192.168.1.0/24"
# Hosting domain: panel.<domain>, <app>.<domain>, previews <branch>-<app>.<domain>
MK_DOMAIN="mirkomil-host.uz"
# Name shown on the login page, in the panel, browser title and alerts
MK_BRAND_NAME="Mirkomil Host"
MK_TAILSCALE="yes"
# auto = disable SSH passwords only after key login is verified; keep; disable
MK_SSH_PASSWORD_AUTH="auto"
MK_TELEGRAM="no"
# TS_AUTHKEY="tskey-auth-..."
# TELEGRAM_BOT_TOKEN="123456789:ABC..."
# TELEGRAM_CHAT_ID="123456789"
